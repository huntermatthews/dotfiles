#! /usr/bin/env fish

source $DOTS_LIBEXEC/dots.fishlib
or begin
    echo "FATAL: could not source dots.fishlib -- exiting program..." 1>&2
    exit 11
end

echo "==> Grabbing a copy of the ssh known hosts..."

if vpn_on
    debug "vpn is on"
    scp salt.nhgri.nih.gov:/etc/ssh/ssh_known_hosts $HOME/.ssh/nhgri_known_hosts
else
    echo "WARNING: vpn is off"
end

