#! /usr/bin/env fish

set -g HELP "\
Usage: $(status basename) [options...] [--list | <subcmd>]

'dots' is Hunter's dotfiles script system.

Optional Arguments
        --debug              Print debug information
    -h, --help               Print this help
        --list               List all subcommands and their descriptions
"

set -gx DOTS_LIBEXEC (status dirname)
source $DOTS_LIBEXEC/dots.fishlib
or begin
    echo "FATAL: could not source dots.fishlib -- exiting program..." 1>&2
    exit 11
end

argparse --name (status basename) --stop-nonopt --ignore-unknown debug h/help list -- $argv
or begin
    echo $HELP
    exit 1
end

if set -q _flag_debug
    set -g FLAG_DEBUG true
end

if set -q _flag_help
    echo $HELP
    exit 0
end

if set -q _flag_list
    echo "Available subcommands:"
    for subcmd in (ls $DOTS_LIBEXEC/dots-*)
        set -l subcmd_name (basename $subcmd | string replace -r '^dots-' '')
        set -l subcmd_desc ($subcmd --desc 2>/dev/null)
        if test -z "$subcmd_desc"
            set subcmd_desc "(no description available)"
        end
        echo "  $subcmd_name: $subcmd_desc"
    end
    exit 0
end

# TODO: Implement --all to run all subcommands in order, skipping any that fail.

if set -q argv[1]
    # First arg is a subcmd - it needs to exist in $DOTS_LIBEXEC
    set -l subcmd $DOTS_LIBEXEC/dots-$argv[1]
    set -l subcmd_args $argv[2..-1]
    debug "subcmd: $subcmd"
    debug "subcmd_args: $subcmd_args"

    # check for the subcmd in $DOTS_LIBEXEC
    if test -x $subcmd
        debug "about to run subcmd program"
        $subcmd $subcmd_args
    else if test -f $subcmd
        panic "subcommand '$argv[1]' found in $DOTS_LIBEXEC, but it is not executable -- you dolt!"
    else
        panic "subcommand '$argv[1]' not found in $DOTS_LIBEXEC"
    end
else
    echo "No subcommand given."
    echo $HELP
    exit 1
end
