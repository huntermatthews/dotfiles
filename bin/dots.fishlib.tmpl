{{ if .is_work }}

function vpn_on
    string match -q -e ">> state: Connected" (/opt/cisco/secureclient/bin/vpn status)
    return $status
end

function vpn_off
    string match -q -e ">> state: Disconnected" (/opt/cisco/secureclient/bin/vpn status)
    return $status
end

function vpn_connect
    echo "ERROR: vpn_connect is not implementable. You need to connect manually."
end

function vpn_disconnect
    if vpn_off
        return 0
    end

    /opt/cisco/secureclient/bin/vpn disconnect
    return $status
end

{{ end }}
