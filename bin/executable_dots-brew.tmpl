#! /usr/bin/env fish

source $DOTS_LIBEXEC/dots.fishlib
or begin
    echo "FATAL: could not source dots.fishlib -- exiting program..." 1>&2
    exit 11
end

if set -q argv[1]; and test "$argv[1]" = "--desc"
    echo "Tell brew to update and upgrade all the things."
    exit 0
end

echo "==> Tell brew to update and upgrade all the things..."

{{ if .is_work }}
# FIXED: dodge our MITM vpn if it's on.
if vpn_on
    echo "VPN is on; you need to disconnect to allow brew to work..."
    return 0
end
{{ end }}

brew update
or panic "brew update failed"

# Brew install/upgrade all the Brewfile things
brew bundle --file $HOMEBREW_BUNDLE_FILE
or panic "brew bundle install/upgrade failed"

# Brew upgrade all the (other) things
brew upgrade
or panic "brew upgrade failed"

## END OF LINE ##
