# Gitconfig
# -*- mode: gitconfig -*-

[user]
	name = Hunter Matthews
	email = {{ .email }}

{{- if .is_work }}
	signingKey = ~/.ssh/id_smartcard.pub
{{- else }}
	signingKey = ~/.ssh/id_github.pub
{{- end }}

[alias]
    # Remember you don't need aliases to ~/bin here - those are found via PATH
    st = status

    all = add -A
    amend = commit --amend -C HEAD
    bprune = fetch --all --tags --prune
    count = !git shortlog -sn
    dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)\"%an\" <%ae>%C(reset) %C(green)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order
    diffi = diff --cached
    root = rev-parse --show-toplevel
    pr = "!f() { git fetch -fu ${2:-upstream} refs/pull/$1/head:pr/$1 && git checkout pr/$1; }; f"
    undo = git reset --soft HEAD~1

    wta = "!f() { git worktree add -b \"$1\" \"../$1\"; }; f"
    wtr = "!f() { git worktree remove \"../$1\"; }; f"
    wtl = "!f() { git worktree list; }; f"

[color]
    diff = auto
    status = auto
    branch = auto
    ui = true

[core]
    editor = zed  --new --wait
    pager = less -FMRiX

[apply]
    whitespace = nowarn

[mergetool]
    keepBackup = false

[difftool]
    prompt = false

[help]
    autocorrect = 1

[push]
    # See `git help config` (search for push.default)
    # for more information on different options of the below setting.
    #
    # Setting to git 2.0 default to surpress warning message
    default = simple
    followTags = true
    autoSetupRemote = True

[pull]
    rebase = true

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[commit]
    template = /Users/matthewsht/.stCommitMsg
    gpgsign = true

[init]
    defaultBranch = main

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.ssh/git_allowed_signers

[tag]
    gpgsign = true

{{ if .is_work -}}
[url "git@github.com:NHGRI"]
    insteadOf = https://github.com/NHGRI
{{- end }}
