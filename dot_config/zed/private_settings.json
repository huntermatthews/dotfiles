// Zed settings
// -*- mode: jsonc -*-
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "title_bar": {
    "show_menus": false,
    "show_sign_in": false
  },
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
      "enable_thinking": true,
      "effort": "high"
    },
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "github-copilot-cli": {
      "favorite_config_option_values": {
        "model": [
          "auto",
          "claude-sonnet-5",
          "claude-sonnet-4.6",
          "gpt-5.4",
          "gpt-5.6-terra",
          "gpt-5.6-luna"
        ]
      },
      "default_config_options": {
        "allow_all": "off",
        "model": "gpt-5.6-luna",
        "mode": "https://agentclientprotocol.com/protocol/session-modes#agent"
      },
      "type": "registry"
    }
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "minimap": {
    "show": "never"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    },
  },
  "base_keymap": "VSCode",
  "project_panel": {
    "hide_gitignore": true,
    "dock": "left"
  },
  "status_bar": {"line_endings_button": true },
  "outline_panel": {
    "button": false,
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "icon_theme": {
    "mode": "system",
    "light": "JetBrains New UI Icons (Dark)",
    "dark": "JetBrains New UI Icons (Dark)"
  },
  "when_closing_with_no_tabs": "close_window",
  "disable_ai": false,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "JetBrains Islands Dark"
  }
}
