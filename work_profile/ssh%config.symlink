UseKeychain yes
AddKeysToAgent yes
IdentitiesOnly yes

# The known_hosts file is pulled down via `dots known-hosts`
StrictHostKeyChecking accept-new

# VPN will terminate long idle connections. Keep them alive.
ServerAliveInterval 300
ServerAliveCountMax 55555

# Treat the trek internal nodes as behind a "bastion" of trek itself...
Host kcompute* kservice* khead* storform* kstorage* kdatabase*
  ProxyJump matthewsht@trek.nhgri.nih.gov
  ForwardAgent yes
  IdentityFile ~/.ssh/id_smartcard.pub

Host github.com-personal
  HostName github.com
  CanonicalizeHostname no
  CanonicalizeFallbackLocal yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_github_personal
  User git

Host github.com
  HostName github.com
  CanonicalizeHostname no
  CanonicalizeFallbackLocal yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_smartcard.pub
  User git

Host * !github.com !github.com-personal
  IdentityFile ~/.ssh/id_smartcard.pub
  ForwardAgent yes
  # subl hack
  RemoteForward 58962 127.0.0.1:52698
  LogLevel=ERROR
  UserKnownHostsFile ~/.ssh/known_hosts
  GlobalKnownHostsFile ~/.ssh/nhgri_known_hosts
