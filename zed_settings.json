      },
      {
        "provider": "Nhgrishell03",
        "model": "gemma4:31b",
        "enable_thinking": false
      }
    ],
    "model_parameters": []
  },
  "agent_servers": {

  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "minimap": {
    "show": "never"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "base_keymap": "VSCode",
  "project_panel": {
    "hide_gitignore": true,
    "dock": "left"
  },
  "status_bar": {"line_endings_button": true },
  "outline_panel": {
    "button": false,
    "dock": "left"
  },
  "collaboration_panel": {
      "button": false
  },
  "git_panel": {
    "dock": "left"
  },
  "git": {
    "show_blame": true,
    "show_status_bar": true,
    // "worktree_directory": ".git/zed-worktrees"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "when_closing_with_no_tabs": "close_window",
  "disable_ai": false,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "JetBrains Islands Dark"
  },
  "terminal": {
    "shell": {
      "program": "/opt/homebrew/bin/fish"
    }
  },
  "semantic_tokens": "combined"
}
