// Zed settings
// -*- mode: jsonc -*-
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "language_models": {
    "openai_compatible": {
      "Nhgrishell03": {
        "api_url": "https://nhgrishell03.nhgri.nih.gov/api",
        "available_models": [
          {
              "name": "mistral-medium-3.5:128b",
              "max_tokens": 200000,
              "max_output_tokens": 32000,
              "max_completion_tokens": 200000,
              "capabilities": {
                "tools": true,
                "images": false,
                "parallel_tool_calls": false,
                "prompt_cache_key": false,
                "chat_completions": true,
                "interleaved_reasoning": false,
                "max_tokens_parameter": false
              }
            },
            {
              "name": "gemma4:31b-it-qat",
              "max_tokens": 200000,
              "max_output_tokens": 32000,
              "max_completion_tokens": 200000,
              "capabilities": {
                "tools": true,
                "images": false,
                "parallel_tool_calls": false,
                "prompt_cache_key": false,
                "chat_completions": true,
                "interleaved_reasoning": false,
                "max_tokens_parameter": false
              }
            },
            {
              "name": "gemma4:31b",
              "max_tokens": 200000,
              "max_output_tokens": 64000,
              "max_completion_tokens": 200000,
              "capabilities": {
                "tools": true,
                "images": false,
                "parallel_tool_calls": false,
                "prompt_cache_key": false,
                "chat_completions": true,
                "interleaved_reasoning": false,
                "max_tokens_parameter": false
              }
            }
        ]
      }
    }
  },
  "auto_update": false,
  "on_last_window_closed": "quit_app",
  "unstable.ui_density": "comfortable",
  "title_bar": {
    "show_menus": false,
    "show_sign_in": false
  },
  "agent": {
    "default_profile": "write",
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "write_paths": [
        {
          "requested": "/Users/matthewsht/Library/Caches/go-build",
          "resolved": "/Users/matthewsht/Library/Caches/go-build"
        }
      ]
    },
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^git\\b"
            },
            {
              "pattern": "^grep\\b"
            }
          ]
        }
      }
    },
    "default_model": {
      "provider": "Nhgrishell03",
      "model": "gemma4:31b",
      "enable_thinking": false
    },
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.7",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-5.3-codex",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-4.6",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-5",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-5.5",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "Nhgrishell03",
        "model": "mistral-medium-3.5:128b",
        "enable_thinking": false
      },
      {
        "provider": "Nhgrishell03",
        "model": "gemma",
        "enable_thinking": false
      },
      {
        "provider": "Nhgrishell03",
        "model": "gemma4:31b-it-qat",
