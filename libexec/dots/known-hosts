#! /usr/bin/env fish

set -g HELP "\
Usage: $(status basename) [options...]

Update the ssh known hosts file from salt.nhgri.nih.gov 

Optional Arguments
        --debug              Print debug information
    -h, --help               Print this help
"

set -g DOTS_LIBEXEC $DOTS/libexec/dots

source $DOTS_LIBEXEC/common-lib.fish
or begin
    echo "FATAL: could not source common-lib.fish -- exiting program..." 1>&2
    exit 11
end

argparse --name (status basename) debug h/help -- $argv
or begin
    echo $HELP
    exit 1
end

if set -q _flag_debug
    set -g FLAG_DEBUG true
end

if set -q _flag_help
    echo $HELP
    exit 0
end

echo "==> Grabbing a copy of the ssh known hosts..."

if test "$DOTS_PROFILE" != "work" 
    echo "WARNING: not at work"
    exit 1
end

if vpn_on
    debug "vpn is on"
    scp salt.nhgri.nih.gov:/etc/ssh/ssh_known_hosts $HOME/.ssh/nhgri_known_hosts
else
    echo "WARNING: vpn is off"
end

## END OF LINE ##
